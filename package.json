{
  "name": "celeris-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build:data": "bun scripts/build-data.ts",
    "validate": "bun scripts/build-data.ts --validate-only",
    "fixtures": "bun scripts/dev-fixtures.ts",
    "demo:data": "bun scripts/dev-fixtures.ts && RESULTS_ROOT=.dev-results bun scripts/build-data.ts",
    "demo": "bun run demo:data && astro dev",
    "dev": "bun run build:data && astro dev",
    "start": "bun run dev",
    "build": "bun run build:data && astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "test": "bun test"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/preact": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@preact/signals": "^2.11.1",
    "astro": "^7.2.10",
    "preact": "^10.29.8",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "bun-types": "^1.4.0",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.4",
    "typescript": "6.0.3",
    "wrangler": "^4.127.1"
  }
}
