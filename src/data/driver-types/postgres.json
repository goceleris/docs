  "gaps": [
    {
      "id": "B11",
      "release": "v1.6.1",
      "summary": "A `[16]byte` array is not accepted as a uuid argument. Pass the uuid as a `string`, or the 16 bytes as a `[]byte`.",
      "error": "celeris-postgres: encode arg 1: celeris-postgres: unsupported argument type [16]uint8; convert to bool/int64/float64/string/[]byte/time.Time or register a codec",
      "issue": "#1361"
    },
    {
      "id": "B12",
      "release": "v1.6.1",
      "summary": "A multi-dimensional array column on a query with arguments is an error with `database/sql` and, with the native `Pool`, for a `string` or an `any`; a buffered native `[]byte` receives the binary wire bytes. A query without arguments returns the array's text. Read it as text with `SELECT col::text`. An array whose lower bound is not 1 returns its elements and drops the bound.",
      "issue": "#1350",
      "error": "postgres/protocol: multi-dimensional array (2 dimensions) is not supported as a column value; cast it to text in the query (col::text) to read its literal"
    },
    {
      "id": "B3",
      "release": "v1.6.1",
      "summary": "A column of a type the driver has no decoder for (time, timetz, interval, inet, cidr, macaddr, oid, and arrays of numeric, date or timestamptz) is read in its binary wire form on a query with arguments, a prepared statement or a query the driver caches. Scanning it into a `string` is an error with the native `Pool`; with `database/sql` the `string` holds the raw wire bytes and there is no error, so the value is wrong without a warning there. A `[]byte` or `any` receives the wire bytes. A query without arguments returns the text. Cast the column to text in the query (`SELECT col::text`). Arrays of a type you create (`enum[]`) and extension types are not guarded: a native `string` receives their raw wire bytes with no error.",
      "issue": "#1352",
      "error": "celeris-postgres: scan: column of type interval (OID 1186) has no decoder in this driver, so a string would be its raw binary wire form; cast it to text in the query (SELECT col::text) or scan into any"
    },
    {
      "id": "B4",
      "release": "v1.6.1",
      "summary": "An array column cannot be scanned into a `string` or a `[]byte` on a query with arguments. With `database/sql` both are an error, shown below. With the native `Pool` a `string` is an error and a `[]byte` receives the array's binary wire bytes (an error on a streamed result). Scan it into an `any` and read the `[]driver.Value`, or cast it to text in the query (`SELECT col::text`). A query without arguments returns the array's text.",
      "error": "sql: Scan error on column index 0, name \"c\": unsupported Scan, storing driver.Value type []driver.Value into type *string",
      "issue": "#1351"
    },
    {
      "id": "B6P",
      "release": "v1.6.1",
      "summary": "The native `Pool` accepts only `bool`, `int`, `int32`, `int64`, `float32`, `float64`, `string`, `[]byte`, `time.Time` and nil as arguments. Everything else is rejected, for example `sql.Null*` types, anything that implements `driver.Valuer`, your own defined types, pointers, `json.RawMessage`, and the integer widths `int8`, `int16`, `uint`, `uint8`, `uint16`, `uint32` and `uint64`. `database/sql` converts most of these. Pass the plain value instead, or use `database/sql`.",
      "error": "celeris-postgres: encode arg 1: celeris-postgres: unsupported argument type sql.NullString; convert to bool/int64/float64/string/[]byte/time.Time or register a codec",
      "issue": "#1359"
    },
    {
      "id": "B8",
      "release": "v1.6.1",
      "summary": "Go slices (`[]string`, `[]int64`) are not accepted as array arguments. Pass the PostgreSQL array text, such as `{a,b}`, as a `string`.",
      "error": "celeris-postgres: encode arg 1: celeris-postgres: unsupported argument type []string; convert to bool/int64/float64/string/[]byte/time.Time or register a codec",
      "issue": "#1348"
    },
    {
      "id": "B9",
      "release": "v1.6.1",
      "summary": "A `time.Time` cannot be passed to a `time` column, and a `time.Time` before year 1 cannot be passed to `timestamptz`. Pass the value as a `string`.",
      "error": "ERROR: invalid input syntax for type time: \"2025-01-15T12:34:56.789123Z\" (SQLSTATE 22007)",
      "issue": "#1349"
    }
  ]
